# 复制为 .env 后填写真实值；.env 永不入库（见 docs/security.md §6）
# 实例身份：现在是进程内唯一实例；将来一实例一进程（见 docs/domain.md §2）
BOT_INSTANCE_ID=default
BOT_TOKEN=123456:REPLACE_ME
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=deepseek-flash
# 逗号分隔的 Bot 别名（用于强触发判定）
BOT_ALIASES=bot
# 运行参数
DATA_DIR=storage
DB_PATH=storage/bot.db
WORKSPACE_ROOT=storage/workspaces
DEBOUNCE_SECONDS=1.2
DEBOUNCE_MAX_MESSAGES=5
HISTORY_DEFAULT=20
HISTORY_COMPLEX=50
# 私聊默认完全不处理（0 token、不写库）；确认要在私聊里对话才设为 true
ALLOW_PRIVATE_CHAT=false
LLM_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
