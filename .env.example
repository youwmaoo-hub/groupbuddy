# 复制为 .env 后填写真实值；.env 永不入库（见 docs/security.md §6）
# 实例身份：现在是进程内唯一实例；将来一实例一进程（见 docs/domain.md §2）
BOT_INSTANCE_ID=default
BOT_TOKEN=123456:REPLACE_ME
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=deepseek-flash
# 采样温度与单次输出上限
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=1024
# 逗号分隔的 Bot 别名（用于强触发判定）
BOT_ALIASES=bot
# 运行参数
DATA_DIR=storage
DB_PATH=storage/bot.db
WORKSPACE_ROOT=storage/workspaces
# VPS 上建议把上面几个路径写成绝对路径（相对路径按进程工作目录解析，见 docs/deployment.md §12.4）
LOG_DIR=storage/logs
LOG_FILE=bot.log
DEBOUNCE_SECONDS=1.2
DEBOUNCE_MAX_MESSAGES=5
HISTORY_DEFAULT=20
HISTORY_COMPLEX=50
# 纯闲聊分档窗口（本轮全部 <10 字且不含问号时使用）
HISTORY_CHITCHAT=10
# 记忆（阶段 6）：动态上下文预算（字符）、摘要触发与上限、调度间隔
HISTORY_BUDGET_CHARS=6000
SUMMARY_MIN_MESSAGES=40
SUMMARY_QUIET_SECONDS=120
SUMMARY_MAX_CHARS=300
SUMMARY_MAX_OUTPUT_TOKENS=400
SUMMARY_POLL_SECONDS=15
# 私聊默认完全不处理（0 token、不写库）；确认要在私聊里对话才设为 true
ALLOW_PRIVATE_CHAT=false
# 发言闸门（阶段 2）：主动回复的追问窗口、冷却与每窗口上限；被压住的消息 0 token
FOLLOWUP_MAX_MESSAGES=5
PROACTIVE_COOLDOWN_SECONDS=20
PROACTIVE_WINDOW_SECONDS=300
PROACTIVE_MAX_PER_WINDOW=3
# 工具（阶段 3）：最多工具轮次；search_web 后端未定，none=不注册该工具，fake=仅离线/演示
TOOL_MAX_ROUNDS=2
SEARCH_BACKEND=none
LLM_TIMEOUT_SECONDS=60
# 配额（阶段 8 F5.3）：0 或未配置 = 不限额；按 chat_id 统计该群日/月消耗的 token
# （含摘要等后台调用；日=按 TIMEZONE 的自然日，月=自然月。语义见 docs/token.md §4.1）
QUOTA_DAILY_TOKENS=0
QUOTA_MONTHLY_TOKENS=0
# 沙箱（阶段 7）：auto=rootless Podman 优先、Docker 备选；none=关闭（run_code 一律 sandbox_unavailable）
SANDBOX_BACKEND=auto
# 镜像必须部署阶段预拉取；运行期不 pull（python -I -c <code>，无网络、只读根、非 root）
SANDBOX_IMAGE=python:3.12-slim
# auto=rootless Podman 用 keep-id 允许挂载本群 workspace；off=关闭 Tier B（Docker 一律不启用）
SANDBOX_TIER_B=auto
SANDBOX_TIMEOUT_DEFAULT=15
SANDBOX_TIMEOUT_MAX=30
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
SANDBOX_PIDS=64
SANDBOX_MAX_CONCURRENT=2
SANDBOX_OUTPUT_KB=8
SANDBOX_TEMP_DIR=storage/sandbox
# 全局人格（System1，见 docs/persona.md）与日期口径（按哪个时区算「今天」）
PERSONA=
TIMEZONE=Asia/Shanghai
# 出站限速与退避（阶段 1；阈值属契约，改动走 AGENTS.md §5）
SEND_RATE_GROUP_PER_MINUTE=15
SEND_RATE_PRIVATE_PER_SECOND=1.0
SEND_RATE_STICKER_PER_SECOND=0.05
SEND_BACKOFF_MAX_SECONDS=60
LOG_LEVEL=INFO
